# FinObs Docker Compose
COMPOSE_PROJECT_NAME=finobs

# Kafka
KAFKA_PORT=9092

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=finobs
MINIO_ROOT_PASSWORD=change_me_before_use

# Spark
SPARK_UI_PORT=8082
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G
# Chu kỳ micro-batch của job Kafka -> bronze (giây)
BRONZE_TRIGGER_SECONDS=15

# Producer: nguồn WebSocket chạy liên tục
PRODUCER_SOURCES=binance,coinbase

# Airflow
AIRFLOW_PORT=8080
AIRFLOW_DB_PASSWORD=change_me_before_use
# Mật khẩu tài khoản admin của Airflow Web UI (tạo tự động khi make up)
AIRFLOW_ADMIN_PASSWORD=change_me_before_use

# Marquez
MARQUEZ_DB_PASSWORD=change_me

# Metric store (PostgreSQL của lớp observability)
METRICS_DB_PORT=5435
METRICS_DB_PASSWORD=change_me_before_use

# Grafana (development/CI example only)
GRAFANA_ADMIN_PASSWORD=change-me-for-local-development

# Alertmanager & Telegram (để trống nếu chưa cấu hình -> dùng receiver "null")
ALERTMANAGER_PORT=9093
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
