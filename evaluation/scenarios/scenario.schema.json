{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finobs.example/evaluation/scenario.schema.json",
  "title": "FinObs evaluation scenario",
  "description": "Một kịch bản lỗi có ground truth. Xem evaluation/scenarios/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_version", "id", "title", "fault_type", "description", "input", "injection", "ground_truth", "evaluation"],
  "properties": {
    "scenario_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^S[0-9]{3}_[a-z0-9_]+$",
      "description": "Trùng với tên file (không có đuôi .yaml)."
    },
    "title": { "type": "string", "minLength": 5 },
    "fault_type": { "$ref": "#/$defs/fault_type" },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "description": { "type": "string", "minLength": 20 },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },

    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sources", "window"],
      "properties": {
        "mode": {
          "enum": ["replay", "synthetic"],
          "description": "replay: phát lại dữ liệu thu thật; synthetic: dữ liệu sinh."
        },
        "dataset": { "type": "string", "description": "Đường dẫn dữ liệu nguồn khi mode = replay." },
        "sources": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["binance", "coinbase", "vnstock"] }
        },
        "symbols": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/utc_ms" },
            "end": { "$ref": "#/$defs/utc_ms" }
          }
        },
        "seed": { "type": "integer", "minimum": 0 }
      }
    },

    "injection": {
      "description": "null với kịch bản đối chứng (is_incident = false).",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["injector", "target", "start_offset_s", "duration_s"],
          "properties": {
            "injector": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": ["layer", "asset"],
              "properties": {
                "layer": { "enum": ["source", "raw", "kafka", "bronze", "silver", "gold", "host"] },
                "asset": { "$ref": "#/$defs/asset" },
                "source": { "enum": ["binance", "coinbase", "vnstock"] },
                "symbols": { "type": "array", "items": { "type": "string" } }
              }
            },
            "start_offset_s": { "type": "number", "minimum": 0 },
            "duration_s": { "type": "number", "exclusiveMinimum": 0 },
            "params": { "type": "object" }
          }
        }
      ]
    },

    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_incident"],
      "properties": {
        "is_incident": { "type": "boolean" },
        "fault_type": { "$ref": "#/$defs/fault_type" },
        "start_offset_s": { "type": "number", "minimum": 0 },
        "end_offset_s": { "type": "number", "exclusiveMinimum": 0 },
        "root_cause": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset", "component", "explanation"],
          "properties": {
            "asset": { "$ref": "#/$defs/asset" },
            "component": { "type": "string" },
            "explanation": { "type": "string", "minLength": 10 }
          }
        },
        "affected_assets": { "type": "array", "items": { "$ref": "#/$defs/asset" }, "uniqueItems": true },
        "expected_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "direction"],
            "properties": {
              "metric": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "group": { "type": "object", "additionalProperties": { "type": "string" } },
              "direction": { "enum": ["up", "down", "shift", "violation", "non_zero", "stable"] },
              "note": { "type": "string" },
              "catalog_status": {
                "enum": ["in_catalog", "proposed"],
                "description": "proposed: metric chưa có trong observability/metric_catalog.yaml."
              }
            }
          }
        },
        "must_not_alert": {
          "type": "array",
          "description": "Tín hiệu mà detector KHÔNG được báo; báo là false positive.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric"],
            "properties": {
              "metric": { "type": "string" },
              "group": { "type": "object", "additionalProperties": { "type": "string" } },
              "note": { "type": "string" }
            }
          }
        }
      },
      "if": { "properties": { "is_incident": { "const": true } } },
      "then": { "required": ["fault_type", "start_offset_s", "end_offset_s", "root_cause", "affected_assets", "expected_signals"] },
      "else": { "not": { "anyOf": [{ "required": ["root_cause"] }, { "required": ["expected_signals"] }] } }
    },

    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics"],
      "properties": {
        "detect_within_s": { "type": "number", "exclusiveMinimum": 0 },
        "diagnose_within_s": { "type": "number", "exclusiveMinimum": 0 },
        "rca_top_k": { "type": "integer", "minimum": 1 },
        "metrics": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["MTTD", "MTTDiag", "precision", "recall", "F1", "AC@k", "false_positive_count"] }
        }
      }
    }
  },

  "$defs": {
    "fault_type": {
      "description": "Mã lỗi; nguồn gốc ở evaluation/fault_taxonomy.md.",
      "enum": [
        "FT01_stale_feed",
        "FT02_volume_loss",
        "FT03_duplicate_events",
        "FT04_history_replay",
        "FT05_late_out_of_order",
        "FT06_clock_skew",
        "FT07_schema_drift",
        "FT08_type_precision",
        "FT09_value_anomaly",
        "FT10_cross_source_mismatch",
        "FT11_pipeline_failure"
      ]
    },
    "asset": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9_.-]+$",
      "description": "Node lineage dạng <namespace>:<tên>, ví dụ finobs:raw.coinbase_trades."
    },
    "utc_ms": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
