{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finobs.example/slo/slo.schema.json",
  "title": "FinObs SLO Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slos"],
  "properties": {
    "schema_version": { "const": 1 },
    "slos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "pillar", "owner", "target", "window_days", "sli", "burn_rate_windows"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "pillar": { "enum": ["freshness", "volume", "completeness", "schema", "distribution"] },
          "description": { "type": "string" },
          "owner": { "enum": ["DE", "OB", "PL", "AI", "EV"] },
          "target": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "window_days": { "type": "integer", "minimum": 1 },
          "trading_schedule": { "enum": ["24x7", "hose_vn30"] },
          "sli": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric_name", "comparator", "threshold"],
            "properties": {
              "metric_name": { "type": "string", "minLength": 1 },
              "comparator": { "enum": ["lte", "gte", "eq"] },
              "threshold": { "type": "number" }
            }
          },
          "burn_rate_windows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "short_window", "long_window", "burn_rate_threshold", "severity"],
              "properties": {
                "name": { "type": "string" },
                "short_window": { "type": "string", "pattern": "^[0-9]+(m|h|d)$" },
                "long_window": { "type": "string", "pattern": "^[0-9]+(m|h|d)$" },
                "burn_rate_threshold": { "type": "number", "exclusiveMinimum": 0 },
                "severity": { "enum": ["critical", "high", "medium", "low"] }
              }
            }
          }
        }
      }
    }
  }
}
