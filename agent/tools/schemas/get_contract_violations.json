{
  "name": "get_contract_violations",
  "description": "Summarise raw records of one source that failed the data contract (platform/contracts) in a time window: how many, which errors, and sample records. A sudden rise limited to one source and one symbol usually means the source changed its payload (schema drift).",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source", "start", "end"],
    "properties": {
      "source": { "enum": ["binance", "coinbase", "vnstock"] },
      "start": { "$ref": "#/$defs/utc_ms" },
      "end": { "$ref": "#/$defs/utc_ms" },
      "sample_limit": { "type": "integer", "minimum": 0, "maximum": 50, "default": 5 }
    },
    "$defs": {
      "utc_ms": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["source", "start", "end", "checked", "invalid", "invalid_rate", "first_violation_at", "by_error", "by_symbol", "samples"],
    "properties": {
      "source": { "type": "string" },
      "start": { "type": "string" },
      "end": { "type": "string" },
      "checked": { "type": "integer", "minimum": 0 },
      "invalid": { "type": "integer", "minimum": 0 },
      "invalid_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
      "first_violation_at": { "type": ["string", "null"] },
      "by_error": {
        "type": "array",
        "items": {
          "type": "object", "additionalProperties": false, "required": ["error", "count"],
          "properties": { "error": { "type": "string" }, "count": { "type": "integer", "minimum": 0 } }
        }
      },
      "by_symbol": { "type": "object", "additionalProperties": { "type": "integer" } },
      "samples": {
        "type": "array",
        "items": {
          "type": "object", "additionalProperties": false, "required": ["event_id", "checked_at", "errors"],
          "properties": {
            "event_id": { "type": "string" },
            "checked_at": { "type": "string" },
            "errors": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
