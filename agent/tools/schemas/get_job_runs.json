{
  "name": "get_job_runs",
  "description": "Return recent runs of a pipeline job (newest first) with state, error message and rows written, plus when it first failed in the window. Use it after get_lineage to check whether a job between a healthy and a stale dataset is failing.",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["job", "start", "end"],
    "properties": {
      "job": { "type": "string", "description": "Job name, e.g. bronze_load, or <namespace>:<name>." },
      "start": { "$ref": "#/$defs/utc_ms" },
      "end": { "$ref": "#/$defs/utc_ms" },
      "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 }
    },
    "$defs": {
      "utc_ms": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["job", "total_in_window", "state_counts", "first_failure_at", "runs"],
    "properties": {
      "job": { "type": "string" },
      "total_in_window": { "type": "integer", "minimum": 0 },
      "state_counts": { "type": "object", "additionalProperties": { "type": "integer" } },
      "first_failure_at": { "type": ["string", "null"] },
      "runs": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_id", "state", "started_at", "ended_at", "error_message", "output_rows"],
          "properties": {
            "run_id": { "type": "string" },
            "state": { "enum": ["RUNNING", "COMPLETED", "FAILED", "ABORTED"] },
            "started_at": { "type": "string" },
            "ended_at": { "type": ["string", "null"] },
            "error_message": { "type": ["string", "null"] },
            "output_rows": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      }
    }
  }
}
